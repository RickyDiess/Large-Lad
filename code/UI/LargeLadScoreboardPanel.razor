@using Sandbox
@using Sandbox.UI
@using System
@using System.Collections.Generic
@using System.Linq
@inherits PanelComponent

<root class="@(scoreboardOpen ? "open" : "closed")">
	@if ( scoreboardOpen )
	{
		<div class="scoreboard-layer">
			<div class="scoreboard-card">
				<div class="scoreboard-heading">
					<div>
						<div class="eyebrow">Large Lad Session</div>
						<div class="title">Players</div>
					</div>
					<div class="player-count">@PlayerCountText</div>
				</div>

				<div class="column-headings">
					<div class="name-column">Player</div>
					<div class="status-column">Status</div>
					<div class="stat-column">K</div>
					<div class="stat-column">D</div>
					<div class="stat-column">A</div>
					<div class="preference-column">Your role preference</div>
				</div>

				<div class="player-list">
					@foreach ( var row in GetPlayerRows() )
					{
						<div class="player-row @(row.IsLocal ? "local" : "remote")">
							<div class="name-column player-name">
								<span>@row.DisplayName</span>
								@if ( row.IsLocal )
								{
									<span class="you-label">You</span>
								}
							</div>

							<div class="status-column role-status">@row.Status</div>
							<div class="stat-column stat-value">@row.Player.SessionKills</div>
							<div class="stat-column stat-value">@row.Player.SessionDeaths</div>
							<div class="stat-column stat-value">@row.Player.SessionAssists</div>

							<div class="preference-column">
								@if ( row.IsLocal )
								{
									<DropDown class="preference-select"
										Value="@GetPreferenceValue( row.Player )"
										Options="@PreferenceOptions"
										ValueChanged="@((string value) => SubmitPreference( row.Player, value ))" />
									@if ( row.Player.IsLocalRolePreferencePending )
									{
										<div class="pending-label">Waiting for host</div>
									}
								}
							</div>
						</div>
					}
				</div>

				<div class="hold-hint">Hold Tab to keep this list open</div>
			</div>
		</div>
	}
</root>

@code
{
	[Property]
	public LargeLadGameManager GameManager { get; set; }

	[Property]
	public LargeLadSessionCoordinator Coordinator { get; set; }

	private static readonly List<Option> PreferenceOptions = new()
	{
		new(
			"I want to play Large Lad",
			((int)LargeLadRolePreference.PreferLargeLad).ToString() ),
		new(
			"I want to play a Skinny Kid",
			((int)LargeLadRolePreference.PreferSkinnyKid).ToString() ),
		new(
			"I don't care",
			((int)LargeLadRolePreference.NoPreference).ToString() )
	};

	private bool scoreboardOpen;
	private bool requestedPreferenceThisOpen;

	private LargeLadSessionCoordinator EffectiveCoordinator =>
		Coordinator ?? GameManager?.SessionCoordinator;

	private string PlayerCountText
	{
		get
		{
			var count = GetPlayerRows().Count;
			return count == 1 ? "1 player" : $"{count} players";
		}
	}

	protected override void OnUpdate()
	{
		base.OnUpdate();

		var shouldOpen =
			!Application.IsDedicatedServer &&
			EffectiveCoordinator?.MapFlowState ==
				LargeLadMapFlowState.Playing &&
			Input.Down( "Score" );

		SetScoreboardOpen( shouldOpen );

		if ( scoreboardOpen )
		{
			LargeLadLocalUiInput.SetScoreboardOpen( true );
			Mouse.Visibility = MouseVisibility.Visible;
		}

		if ( !scoreboardOpen || requestedPreferenceThisOpen )
			return;

		var localPlayer = GetPlayerRows()
			.FirstOrDefault( row => row.IsLocal )?
			.Player;

		if ( localPlayer?.RefreshLocalRolePreference() == true )
			requestedPreferenceThisOpen = true;
	}

	protected override void OnDisabled()
	{
		SetScoreboardOpen( false );
		base.OnDisabled();
	}

	protected override void OnDestroy()
	{
		SetScoreboardOpen( false );
		base.OnDestroy();
	}

	private void SetScoreboardOpen( bool shouldOpen )
	{
		if ( scoreboardOpen == shouldOpen )
			return;

		scoreboardOpen = shouldOpen;
		requestedPreferenceThisOpen = false;
		LargeLadLocalUiInput.SetScoreboardOpen( shouldOpen );
		Mouse.Visibility = shouldOpen
			? MouseVisibility.Visible
			: MouseVisibility.Auto;

		if ( !shouldOpen )
			Panel?.Blur();
	}

	private List<PlayerRow> GetPlayerRows()
	{
		var rows = new List<PlayerRow>();
		var seenConnections = new HashSet<Guid>();

		foreach ( var player in GameManager?.ActivePlayers ??
			Array.Empty<LargeLadPlayer>() )
		{
			if ( player is null || !player.IsValid || !player.Enabled )
				continue;

			var connection = player.Network.Owner ??
				Connection.Find( player.Network.OwnerId );
			if ( connection is null ||
				!connection.IsActive ||
				!seenConnections.Add( connection.Id ) )
			{
				continue;
			}

			rows.Add( new PlayerRow
			{
				Player = player,
				ConnectionId = connection.Id,
				DisplayName = string.IsNullOrWhiteSpace(
					connection.DisplayName )
					? player.GameObject.Name
					: connection.DisplayName,
				IsLocal = player.IsOwnedByLocalPlayer(),
				Status = GetStatusText( player )
			} );
		}

		return rows
			.OrderByDescending( row => row.IsLocal )
			.ThenBy( row => row.DisplayName, StringComparer.OrdinalIgnoreCase )
			.ThenBy( row => row.ConnectionId )
			.ToList();
	}

	private static string GetPreferenceValue( LargeLadPlayer player )
	{
		return ((int)(player?.LocalAcceptedRolePreference ??
			LargeLadRolePreference.NoPreference)).ToString();
	}

	private static void SubmitPreference(
		LargeLadPlayer player,
		string value )
	{
		if ( player is null ||
			!int.TryParse( value, out var parsed ) )
		{
			return;
		}

		player.SubmitLocalRolePreference(
			(LargeLadRolePreference)parsed );
	}

	private static string GetStatusText( LargeLadPlayer player )
	{
		var roleName = player.Role switch
		{
			LargeLadRole.SkinnyKid => "Skinny Kid",
			LargeLadRole.LargeLad => "Large Lad",
			LargeLadRole.Minion => "Minion",
			_ => "Lobby"
		};

		if ( player.Health?.IsDead != true )
			return roleName;

		if ( player.PendingRespawnRole != LargeLadRole.Unassigned &&
			player.PendingRespawnRole != player.Role )
		{
			var nextRole = player.PendingRespawnRole == LargeLadRole.Minion
				? "Minion"
				: player.PendingRespawnRole.ToString();
			return $"Dead · {nextRole} next";
		}

		return $"Dead · {roleName}";
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( scoreboardOpen );
		hash.Add( EffectiveCoordinator?.MapFlowState );

		if ( !scoreboardOpen )
			return hash.ToHashCode();

		foreach ( var row in GetPlayerRows() )
		{
			hash.Add( row.ConnectionId );
			hash.Add( row.DisplayName );
			hash.Add( row.Status );
			hash.Add( row.IsLocal );
			hash.Add( row.Player.SessionKills );
			hash.Add( row.Player.SessionDeaths );
			hash.Add( row.Player.SessionAssists );

			if ( row.IsLocal )
			{
				hash.Add( row.Player.LocalAcceptedRolePreference );
				hash.Add( row.Player.IsLocalRolePreferencePending );
			}
		}

		return hash.ToHashCode();
	}

	private sealed class PlayerRow
	{
		public LargeLadPlayer Player { get; init; }
		public Guid ConnectionId { get; init; }
		public string DisplayName { get; init; }
		public bool IsLocal { get; init; }
		public string Status { get; init; }
	}
}
